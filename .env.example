# Copie para .env.local e preencha os valores.

# API Groq (obrigatório para /api/groq e script test-groq)
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=

# API Gemini (para /api/gemini/transform)
# Obtenha em: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# URL do JSON de provas (opcional). GET /api/provas coleta os dados desta URL.
# Se não definido, a API retorna um JSON vazio.
# PROVAS_JSON_URL=

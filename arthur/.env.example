# ──────────────────────────────────────────────────────────────────────────────
# Configuração do Crawler Contador de Questões
# ──────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus dados:
#   cp .env.example .env
#
# Como obter os cookies:
#   1. Abra o site https://www.provaderesidencia.com.br no Chrome/Firefox
#   2. Faça login na sua conta premium
#   3. Pressione F12 → Application → Cookies → www.provaderesidencia.com.br
#   4. Copie os valores de: csrftoken, tkpd, cf_clearance, sessionid
#   5. Monte TUDO em UMA única linha abaixo (não crie variáveis soltas)
#
# Formato correto (UMA linha só):
#   CRAWLER_COOKIE_HEADER=csrftoken=AAA; sessionid=BBB; cf_clearance=CCC; tkpd=DDD
#
# Erros comuns:
#   ✗ Colar cookies no .env.example (use .env — não é commitado)
#   ✗ Colar cada cookie em linhas separadas (cf_clearance=... sozinho)
#   ✗ Deixar placeholders SEU_TOKEN / SEU_CF_CLEARANCE
#   ✗ Esquecer o prefixo CRAWLER_COOKIE_HEADER=
#
# IMPORTANTE: Execute o crawler na mesma máquina/IP em que fez o login.
# O cf_clearance é vinculado ao seu IP — em outros servidores, o Cloudflare bloqueia.
# ──────────────────────────────────────────────────────────────────────────────

CRAWLER_COOKIE_HEADER=

# URL da listagem (deixe vazio para usar o perfil --perfil)
# CRAWLER_URL_PROVAS=https://www.provaderesidencia.com.br/premium/banco-de-provas

# Limite de provas a processar (0 = todas)
CRAWLER_MAX_PROVAS=0

# Delay em segundos entre requisições (mínimo recomendado: 1.5)
CRAWLER_DELAY=1.5

# Arquivo de saída (opcional)
CRAWLER_SAIDA=exports/contagem_questoes.json
